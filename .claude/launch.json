{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "denizen",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--no-warnings", "--env-file=.env", "server.js"],
      "cwd": "denizen",
      "port": 8080,
      "autoPort": false,
      "waitForPort": 5000
    },
    {
      "name": "crm",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "denizen/crm/vendor",
      "port": 8090,
      "autoPort": false,
      "waitForPort": 30000
    }
  ]
}
