{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "denizen",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--no-warnings",
        "--env-file=.env",
        "server.js"
      ],
      "cwd": "denizen",
      "port": 8080,
      "autoPort": false,
      "waitForPort": 5000
    },
    {
      "name": "pixel-map",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "-l",
        "5179",
        "."
      ],
      "cwd": "discord pixel game",
      "port": 5179
    },
    {
      "name": "crm",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "denizen/crm/vendor",
      "port": 8090,
      "autoPort": false,
      "waitForPort": 30000
    },
    {
      "name": "discord-map",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "-l",
        "5191",
        "."
      ],
      "cwd": "denizen/discord-map",
      "port": 5191
    }
  ]
}