# DENIZEN_SPECTATE_PUBLIC_URL=https://spectate.dolonia.cloud
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_TUNNEL_ID=
#
# Anthropic — for coding-agent (Claude Code CLI) on NAS. NEVER commit a real key.
# 1) Set a billing spend cap in console.anthropic.com first (or use a dedicated capped key).
# 2) Add here; patch-denizen-nas-env.py forwards to /volume1/docker/denizen-server/.env at runtime.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional — NPC chat Haiku demos (falls back to ANTHROPIC_API_KEY if unset):
# DENIZEN_PUBLIC_DEMO_ANTHROPIC_KEY=sk-ant-...
KALI_HOST=100.110.205.49
KALI_USER=dolo
KALI_DENIZEN_URL=https://denizen.dolonia.cloud
KALI_SSH_PASSWORD=
