# Copy to infra/.env and fill in (infra/.env is gitignored)
SYNO_HOST=192.168.1.237
SYNO_USER=admin
SYNO_SSH_PASSWORD=
SYNO_DENIZEN_PORT=8888
SYNO_DENIZEN_DIR=/volume1/docker/denizen-server
DENIZEN_PUBLIC_URL=https://denizen.dolonia.cloud
DENIZEN_NAS_URL=http://192.168.1.237:8888
