# Temp Claude agent working directories
tmpclaude-*-cwd

# Claude settings with local secrets
.claude/settings.local.json
.claude/worktrees/

# Denizen runtime data (lazy-created by the server; committing causes
# constant CRLF/content drift on Windows)
denizen/data/animation-proposals.json
denizen/data/soul-proposals.json
denizen/data/capability-proposals.json
denizen/data/assistant-profile.json
denizen/data/email-drafts.json
denizen/data/email-log.json
denizen/data/gmail-oauth.json
denizen/data/llm-telemetry.jsonl
# Robinhood — token and runtime data (never commit)
denizen/data/robinhood-oauth.json
denizen/data/trade-suggestions.json
denizen/data/roki-watchlist.json

# Embedded git repos (tracked separately)
openclaw/
.github/

# Large raw game asset dumps (binary files, not source code)
pixel game stuff/
pixel-game/
pixel-office-game/

# Python virtual environment
.venv/
__pycache__/
*.pyc

# Node modules (restored via npm/pnpm install)
node_modules/

# OpenClaw compiled output
openclaw/dist/
openclaw/apps/*/node_modules/
openclaw/extensions/*/node_modules/

# Environment / secrets — never commit these
.env
.env.local
.env.*.local
openclaw/.env

# Build artifacts
*.log
*.tmp

# OS
.DS_Store
Thumbs.db

# Windows junk
nul
