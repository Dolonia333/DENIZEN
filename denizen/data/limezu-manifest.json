    // Assign one per NPC — existing animRegistry.js works with no changes.

    { "zip": "interiors", "src": "2_Characters/Character_Generator/0_Premade_Characters/16x16/Premade_Character_01.png","dest": "characters/char_01.png" },
    { "zip": "interiors", "src": "2_Characters/Character_Generator/0_Premade_Characters/16x16/Premade_Character_02.png","dest": "characters/char_02.png" },
    { "zip": "interiors", "src": "2_Characters/Character_Generator/0_Premade_Characters/16x16/Premade_Character_03.png","dest": "characters/char_03.png" },
    { "zip": "interiors", "src": "2_Characters/Character_Generator/0_Premade_Characters/16x16/Premade_Character_04.png","dest": "characters/char_04.png" },
    { "zip": "interiors", "src": "2_Characters/Character_Generator/0_Premade_Characters/16x16/Premade_Character_05.png","dest": "characters/char_05.png" },
    { "zip": "interiors", "src": "2_Characters/Character_Generator/0_Premade_Characters/16x16/Premade_Character_06.png","dest": "characters/char_06.png" },
    { "zip": "interiors", "src": "2_Characters/Character_Generator/0_Premade_Characters/16x16/Premade_Character_07.png","dest": "characters/char_07.png" },
