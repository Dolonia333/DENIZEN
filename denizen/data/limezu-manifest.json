    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_TV_reportage.png",                "dest": "animated/tv.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_old_tv.png",                      "dest": "animated/tv_old.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_canteen_counter.png",             "dest": "animated/canteen_counter.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_canteen_fridge_empty.png",        "dest": "animated/canteen_fridge.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_escalator_up.png",                "dest": "animated/escalator_up.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_escalator_down.png",              "dest": "animated/escalator_down.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_door_glass_double.png",           "dest": "animated/door_glass.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_door_sliding_glass.png",          "dest": "animated/door_sliding.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_japanese_sliding_door.png",       "dest": "animated/japanese_door.png" },

