    // ── ROOM DESIGN EXAMPLES (reference for how layers stack) ────────────────
    // These are the ONLY assembly docs LimeZu provides. Kept for reference.

    { "zip": "interiors", "src": "6_Home_Designs/Gym_Designs/16x16/Gym_preview.png",           "dest": "examples/gym_preview.png" },
    { "zip": "interiors", "src": "6_Home_Designs/Gym_Designs/16x16/Gym_layer_1.png",           "dest": "examples/gym_layer1.png" },
