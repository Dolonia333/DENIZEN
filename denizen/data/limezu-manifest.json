    // ── EXTERIORS ────────────────────────────────────────────────────────────
    // Building_1 = LIME CORP warm-grey tower (use as DOLONIA HQ)
    // Building_4 = G-NERIC CORP cool-grey modern glass (use for neighbor buildings)
    // Naming: Left + Middle_Modular (tile N times) + Right = one floor
    // Stack floor rows = any building height

    { "zip": "exteriors", "src": "Modern_Exteriors_16x16/ME_Theme_Sorter_16x16/16_Office_16x16.png",       "dest": "exteriors/office_all.png" },
    { "zip": "exteriors", "src": "Modern_Exteriors_16x16/ME_Theme_Sorter_16x16/2_City_Terrains_16x16.png", "dest": "exteriors/city_terrain.png" },
