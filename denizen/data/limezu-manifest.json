    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_control_room_facebook_scrolling.png","dest": "animated/social_feed.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_receptionist.png",                "dest": "animated/receptionist.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_receptionist_2.png",              "dest": "animated/receptionist_2.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_treadmill.png",                   "dest": "animated/treadmill.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_punching_bag_left.png",           "dest": "animated/punching_bag_l.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_punching_bag_right.png",          "dest": "animated/punching_bag_r.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_security_camera_wall_left_.png",  "dest": "animated/security_cam_l.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_security_camera_wall_right_.png", "dest": "animated/security_cam_r.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_fridge.png",                      "dest": "animated/fridge.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_fridge_grey.png",                 "dest": "animated/fridge_grey.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_kitchen_oven.png",                "dest": "animated/oven.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_kitchen_sink_1.png",              "dest": "animated/sink.png" },
