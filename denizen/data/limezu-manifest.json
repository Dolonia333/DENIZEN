    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_coffee.png",                      "dest": "animated/coffee.png" },
    { "zip": "interiors", "src": "3_Animated_objects/16x16/spritesheets/animated_control_room_server.png",         "dest": "animated/server_rack.png" },
