{
  "_comment": "LimeZu asset extraction manifest. Run: node scripts/extract-limezu.js",
  "sources": {
    "interiors": "C:/Users/zionv/Downloads/all sprite files/moderninteriors-win.zip",
    "exteriors": "C:/Users/zionv/Downloads/all sprite files/modernexteriors-win.zip",
    "farm":      "C:/Users/zionv/Downloads/all sprite files/Modern_Farm_v1.2.zip",
    "ui":        "C:/Users/zionv/Downloads/all sprite files/modernuserinterface-win.zip"
  },
  "outputBase": "assets/limezu",
  "extract": [

    // ── ROOM BUILDER ─────────────────────────────────────────────────────────
    // Layer 1 of every interior room. Sub-files are split by purpose.
    // floors.png    → fill the room interior with chosen tile row
    // walls_3d.png  → the angled top wall strip (the LimeZu signature look)
    // walls.png     → flat side/bottom wall panels
    // shadows.png   → subtle floor shadow along wall base (optional depth)
    // arches.png    → interior archway doorways between rooms

    { "zip": "interiors", "src": "1_Interiors/16x16/Room_Builder_16x16.png",                                    "dest": "room-builder/master.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Room_Builder_subfiles/Room_Builder_Floors_16x16.png",       "dest": "room-builder/floors.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Room_Builder_subfiles/Room_Builder_Walls_16x16.png",        "dest": "room-builder/walls.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Room_Builder_subfiles/Room_Builder_3d_walls_16x16.png",     "dest": "room-builder/walls_3d.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Room_Builder_subfiles/Room_Builder_Floor_Shadows_16x16.png","dest": "room-builder/floor_shadows.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Room_Builder_subfiles/Room_Builder_Arched_Entryways_16x16.png","dest": "room-builder/arches.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Room_Builder_subfiles/Room_Builder_Floor_Paths_16x16.png",  "dest": "room-builder/floor_paths.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Room_Builder_subfiles/Room_Builder_Baseboards_16x16.png",   "dest": "room-builder/baseboards.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Room_Builder_subfiles/Room_Builder_borders_16x16.png",      "dest": "room-builder/borders.png" },

    // ── INTERIOR THEME SHEETS (Layer 2 furniture) ────────────────────────────
    // Each theme sheet is the merged reference. Individual sprites live in
    // the Singles sub-folders (extracted below per room type).

    { "zip": "interiors", "src": "1_Interiors/16x16/Interiors_16x16.png",                                "dest": "themes/all_interiors.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/8_Gym_16x16.png",                       "dest": "themes/gym.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/12_Kitchen_16x16.png",                  "dest": "themes/kitchen.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/13_Conference_Hall_16x16.png",          "dest": "themes/conference.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/14_Basement_16x16.png",                 "dest": "themes/lounge.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/5_Classroom_and_library_16x16.png",     "dest": "themes/library.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/3_Bathroom_16x16.png",                  "dest": "themes/bathroom.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/23_Television_and_Film_Studio.png",     "dest": "themes/studio.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/1_Generic_16x16.png",                   "dest": "themes/generic.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/2_LivingRoom_16x16.png",                "dest": "themes/living_room.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/19_Hospital_16x16.png",                 "dest": "themes/medical.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/6_Music_and_sport_16x16.png",           "dest": "themes/music.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/20_Japanese_interiors.png",             "dest": "themes/japanese.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/18_Jail_16x16.png",                     "dest": "themes/jail.png" },
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter/4_Bedroom_16x16.png",                   "dest": "themes/bedroom.png" },

    // ── INTERIOR SINGLES (individual sprites, loaded by key in Phaser) ───────
    // These are the actual usable sprites. Each file = one furniture piece.
    // Gym singles (210 sprites)
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter_Singles/8_Gym_Singles/",       "dest": "singles/gym/",       "glob": true },
    // Kitchen singles (409 sprites)
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter_Singles/12_Kitchen_Singles/",  "dest": "singles/kitchen/",   "glob": true },
    // Conference singles (69 sprites)
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter_Singles/13_Conference_Hall_Singles/", "dest": "singles/conference/", "glob": true },
    // Lounge/basement singles
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter_Singles/",                     "dest": "singles/lounge/",    "glob": true, "filter": "14_Basement" },
    // Library singles
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter_Singles/",                     "dest": "singles/library/",   "glob": true, "filter": "5_Classroom" },
    // Japanese home (tatami, shoji, kotatsu — ref image 1)
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter_Singles/",                     "dest": "singles/japanese/",  "glob": true, "filter": "20_Japanese" },
    // Jail / prison cells + security (ref image 2)
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter_Singles/",                     "dest": "singles/jail/",      "glob": true, "filter": "18_Jail" },
    // TV / news studio furniture (ref image 3)
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter_Singles/",                     "dest": "singles/studio/",    "glob": true, "filter": "23_Television" },
    // Medical (infirmary wing beside jail)
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter_Singles/",                     "dest": "singles/medical/",   "glob": true, "filter": "19_Hospital" },
    // Generic singles
    { "zip": "interiors", "src": "1_Interiors/16x16/Theme_Sorter_Shadowless/1_Generic_Shadowless.png",  "dest": "themes/generic_shadowless.png" },

    // ── ANIMATED OBJECTS ─────────────────────────────────────────────────────
