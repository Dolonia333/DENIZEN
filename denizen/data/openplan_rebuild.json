{
  "id": "hu4gzs_openplan_rebuild_v1",
  "label": "Hu4Gzs open-plan office",
  "status": "spec",
  "referenceImage": "assets/ref_Hu4Gzs.png",
  "referenceImageLegacy": "Hu4Gzs-b4f88a09-6596-4d5f-b9ba-e3779f16bda9.png",
  "layoutParam": "reference_office",
  "zonesFile": "data/openplan_zones.json",
  "tileCatalog": "data/room-builder-tiles.json",
  "furnitureCatalog": "data/furniture_catalog_openplan.json",
  "room": {
    "originPx": { "x": 16, "y": 32 },
    "sizePx": { "w": 1264, "h": 700 },
    "placementExtentPx": { "xMin": 52, "xMax": 1228, "yMin": 64, "yMax": 700 }
  },
    "_note": "Default game uses hand-tuned tileSprite floors + drawHWall walls in office-scene.js — NOT RoomTileRenderer. LimeZu 16px shell looked blocky; kept as optional experiment only.",
  "pipeline": [
    {
      "order": 1,
      "step": "shell",
      "description": "Draw perimeter walls and internal dividers (16px shell tiles)",
      "renderer": "src/room-tile-renderer.js",
      "inputs": ["data/openplan_zones.json", "data/room-builder-tiles.json"],
      "walls": {
        "perimeter": { "insetPx": 16, "topThickTiles": 3 },
        "verticalDivider": { "x": 848, "doorGaps": [{ "y0": 160, "y1": 256 }, { "y0": 328, "y1": 424 }] },
        "horizontalDividerLeft": { "y": 448, "doorGap": { "x0": 288, "x1": 384 } },
        "horizontalDividerRight": { "y": 256, "doorGap": { "x0": 1000, "x1": 1096 } }
      }
    },
    {
      "order": 2,
      "step": "zones",
      "description": "Fill floor and wall styles per zone bounds",
      "config": "data/openplan_zones.json",
      "tileCatalog": "data/room-builder-tiles.json"
    },
    {
      "order": 3,
      "step": "furniture",
      "description": "Spawn furniture from catalog placements (32px grid, bottom-center anchor)",
      "source": "data/furniture_catalog_openplan.json",
      "field": "placements",
      "preprocess": "npm run catalog:snap"
    },
    {
      "order": 4,
      "step": "decor",
      "description": "Desk-bound decor (monitors, laptops, lamps, phones, paper) and wall-mounted items",
      "source": "data/furniture_catalog_openplan.json",
      "filter": { "types": ["decor"], "parentBound": true },
      "zones": ["open_plan", "side_office_left", "side_office_right", "top_wall_decor_band"]
    },
    {
      "order": 5,
      "step": "characters",
      "description": "Spawn player and NPC wander anchors",
      "spawnPoints": "spawnPoints"
    }
  ],
  "spawnPoints": {
    "player": { "x": 300, "y": 260, "facing": "down", "zone": "open_plan" },
    "npcs": [
      { "id": "xp_abby", "x": 200, "y": 210, "zone": "open_plan", "role": "worker" },
      { "id": "xp_alex", "x": 400, "y": 390, "zone": "open_plan", "role": "worker" },
      { "id": "xp_bob", "x": 640, "y": 590, "zone": "break_area", "role": "visitor" },
      { "id": "xp_dan", "x": 980, "y": 270, "zone": "side_office_left", "role": "manager" }
    ]
  },
  "zonePlacements": {
    "open_plan": {
      "tags": ["cubicle_desk", "cubicle_divider", "chair_", "desk_setup", "plant_", "bookshelf", "water_dispenser", "trash_can"]
    },
    "lounge": {
      "tags": ["sofa", "corner_sofa", "small_table", "money_", "plant_tree", "box_desk"]
    },
    "break_area": {
      "tags": ["vending", "waiting_row", "water_dispenser", "cert_", "chair_blue"]
    },
    "side_office_left": {
      "tags": ["cubicle_desk", "desk_setup", "chair_orange", "money_", "sofa", "plant_tree", "cert_"]
    },
    "side_office_right": {
      "tags": ["box_desk", "cubicle_desk", "coffee_machine", "cork_board", "bookshelf", "chair_"]
    },
    "top_wall_decor_band": {
      "tags": ["whiteboard", "bookshelf", "cert_", "pop_art", "ac_unit"]
    }
  },
  "expectedAdditions": {
    "_note": "Catalog-only refs from reference_sprite_inventory that this rebuild places",
    "fromCatalogOnly": [
      { "ref": "desk_lamp_silver", "catalogId": "desk_lamp_sheet", "count": 7, "zone": "open_plan" },
      { "ref": "telephone_grey", "catalogId": "phone", "count": 3, "zone": "open_plan" },
      { "ref": "paper_stack_desk", "catalogId": "paper_small", "count": 4, "zone": "open_plan" },
      { "ref": "whiteboard_bar_graph", "catalogId": "whiteboard_graphs", "count": 1, "zone": "top_wall_decor_band" },
      { "ref": "whiteboard_pie_chart", "catalogId": "whiteboard_charts", "count": 1, "zone": "top_wall_decor_band" },
      { "ref": "printer_floor_stand", "catalogId": "printer_large_sheet", "count": 2, "zone": "open_plan" },
      { "ref": "side_table_wood", "catalogId": "small_table_sheet", "count": 1, "zone": "lounge" },
      { "ref": "cork_bulletin_board", "catalogId": "cork_board_sheet", "count": 1, "zone": "side_office_right" }
    ],
    "inventoryImpact": {
      "placedBefore": 38,
      "catalogOnlyBefore": 8,
      "placedAfter": 46,
      "catalogOnlyAfter": 0
    }
  },
  "commands": {
    "snapPlacements": "npm run catalog:snap",
    "validate": "npm run validate:catalog",
    "rebuildObjects": "npm run catalog:rebuild && npm run catalog:merge"
  }
}
