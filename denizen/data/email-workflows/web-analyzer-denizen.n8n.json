        "jsCode": "const leadPayload = $('Prepare Denizen lead').first()?.json || {};\nconst denizen = $('POST \u2192 Denizen lead intake').first()?.json || {};\nconst lm = $('Send to LM Studio').first()?.json || {};\nreturn [{\n  json: {\n    ok: true,\n    analyzer: 'Dolonia Web Analyzer',\n    denizen,\n    lead: leadPayload,\n    lmStudio: lm,\n  },\n}];\n"
      },
