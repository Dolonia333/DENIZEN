{
  "name": "send_handoff",
  "description": "Send a message/handoff to a teammate, or escalate to the CEO office (Lucy bridge). Optional document attaches a research brief for same-org sharing from ChatGPT/Claude/Cursor MCP — the office shows a folder-carry delivery.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "description": "Handoff message (required)"
      },
      "to_session_id": {
        "type": "string",
        "description": "Target teammate session UUID"
      },
      "to_display_name": {
        "type": "string",
        "description": "Target by display name (partial match)"
      },
      "to_ceo": {
        "type": "boolean",
        "description": "Escalate to CEO / Lucy bridge"
      },
      "to_npc": {
        "type": "string",
        "description": "Optional target NPC key for routing metadata"
      },
      "document": {
        "type": "object",
        "description": "Optional research handoff document shared inside the same Denizen org",
        "properties": {
          "title": {
            "type": "string",
            "description": "Brief title"
          },
          "summary": {
            "type": "string",
            "description": "Short summary of findings"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Source URLs or citation strings"
          },
          "brief_id": {
            "type": "string",
            "description": "Optional research brief id / path"
          }
        }
      }
    },
    "required": [
      "message"
    ]
  }
}
