# Denizen production environment template.
# Copy to .env.production and fill with real values in your deploy system.

SUPABASE_URL=https://supabase.dolonia.cloud
# Required for server-side DB (compute queue, facts, sessions). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Optional on server; fleet/desktop agents may use anon for mesh node APIs.
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require
DENIZEN_URL=https://denizen.dolonia.cloud
# Public URL for OpenAPI, MCP connect, and desktop pairing (no trailing slash)
DENIZEN_PUBLIC_URL=https://denizen.dolonia.cloud

# Web research — Brave Search API (background research skill + cited visitor research)
# BRAVE_SEARCH_API_KEY=
# Without Brave key, research uses visible browser via mesh (see DENIZEN_MESH_BROWSER).
# DENIZEN_RESEARCH_BACKEND=auto
# DENIZEN_MESH_BROWSER=1
# DENIZEN_MESH_BROWSER_HOST=<PC_LAN_IP>

# MiroFish prediction engine (optional — falls back to heuristics when disabled/unreachable)
# MIROFISH_ENABLED=false
# MIROFISH_BASE_URL=http://localhost:5001

# Robinhood read-only OAuth (optional — or set ROBINHOOD_API_TOKEN)
# ROBINHOOD_API_TOKEN=

# Team lead — auto-promoted to owner on register/login; owner login is unified CEO/host (no separate CEO code)
DENIZEN_TEAM_OWNER_EMAIL=zionvanzandt@gmail.com

# MCP UI inspect + Playwright probes (optional — set on deploy machine, never commit real password)
# PROBE_OWNER_USER=Dolonia
# PROBE_OWNER_PASS=
# PROBE_TEAM_CODE=1921

# Password policy: production requires 6+ chars. Local dev (NODE_ENV != production) allows 3+.
# Force off in dev: DENIZEN_DEV_RELAXED_PASSWORD=false
# Force on in prod (not recommended): DENIZEN_DEV_RELAXED_PASSWORD=true

# Visitor identity + notifications (optional)
# RESEND_API_KEY=
# DENIZEN_EMAIL_FROM=Denizen <onboarding@resend.dev>
# RESEND_WEBHOOK_SECRET=whsec_...  # Resend dashboard → Webhooks → signing secret
# CRM Resend webhook URL: https://YOUR_HOST/api/crm/resend-webhook (events: email.opened, email.clicked, email.delivered)
# Gmail → CRM inbound (Angela / allowlisted senders → Meridian). Needs gmail.readonly scope.
# GMAIL_INBOUND=1
# GMAIL_INBOUND_FROM=vzion253@gmail.com,angelavanzandt1921@gmail.com
# GMAIL_INBOUND_ORG_SLUG=zion
# GMAIL_INBOUND_AUTO_TASK=0          # 0 = suggest follow-up for Angela to Accept; 1 = auto-create task
# GMAIL_INBOUND_TASK_DUE_DAYS=2
# GMAIL_OAUTH_FILE=/app/data/gmail-oauth.json
# DENIZEN_EMAIL_SECRET=
# DISCORD_VISITOR_WEBHOOK_URL=
#
# Discord bot + OAuth (Discord Spaces map / visitor link)
# Discord Spaces product (free watermark vs paid branding)
# DENIZEN_SPACES_PLAN=free          # free | community | pro
# DENIZEN_SPACES_REMOVE_BRANDING=0  # 1 = hide "Powered by Denizen Spaces"
#
# DISCORD_BOT_TOKEN=
# DISCORD_CLIENT_ID=          # Application ID (OAuth2 client)
# DISCORD_APPLICATION_ID=     # alias for CLIENT_ID
# DISCORD_CLIENT_SECRET=      # OAuth2 client secret
# DISCORD_GUILD_ID=           # optional guild filter for the bot
# DISCORD_PRESENCE_PORT=5180
# DISCORD_BRIDGE_SECRET=      # bot → office presence POST auth
# DISCORD_OFFICE_ID=ceo-operator
# DENIZEN_DISCORD_BOT=auto    # auto|off — spawn bot sidecar from server.js
# DISCORD_SLASH_TRIM=1       # set to 1 to keep slash commands under Discord's 100 cap
                              # by making economy/pvp/shop/minigames prefix-only
                              # (seller slots, moderation, music, etc. stay as slash)
# Lavalink v4 (music) — https://github.com/lavalink-devs/Lavalink
# Defaults already target 127.0.0.1:2333 / youshallnotpass (set LAVALINK_DISABLE=1 to skip)
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_DISABLE=1
# LASTFM_API_KEY=          # https://www.last.fm/api/account/create — ,lastfm / WhoKnows
# FORTNITE_API_KEY=        # fortnite-api.com — ,fortnite
# YOUTUBE_API_KEY=         # YouTube Data API — ,social bind youtube
# DENIZEN_SESSION_SIGNING_KEY= # long random secret; AGENT_TOKEN is fallback
# OAuth redirect URI (register in Discord Developer Portal → OAuth2):
#   https://YOUR_HOST/api/visitor/auth/discord/callback

# CRM client portal — Stripe Checkout (optional)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe webhook URL: https://YOUR_HOST/api/crm/stripe-webhook (event: checkout.session.completed)

# CRM calendar sync — Google / Microsoft OAuth (optional)
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# Google redirect URI: https://YOUR_HOST/api/crm/calendar/google/callback
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# Microsoft redirect URI: https://YOUR_HOST/api/crm/calendar/microsoft/callback

# Content pipeline (autonomous newsroom) — optional scheduled runs
# CONTENT_PIPELINE_SCHEDULE=true
# CONTENT_PIPELINE_INTERVAL_MS=21600000

# Platform CMS publish (Lucy platform-publish skill) — Lovable site + Supabase CRM
# PLATFORM_CMS_TABLE=blog_posts
# PLATFORM_DEFAULT_STATUS=draft
# LOVABLE_SITE_DIR=C:\path\to\your\lovable-export
# PLATFORM_SITE_EXPORT_DIR=C:\path\to\your\lovable-export
# Optional WordPress on Synology Docker (only if you add it later):
# WORDPRESS_URL=http://<NAS_IP>:8088
# WORDPRESS_USERNAME=editor
# WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Compute network — protects POST /api/compute/jobs/enqueue (optional)
# DENIZEN_INTERNAL_API_TOKEN=

# Mesh job producer — auto-enqueues npc_think_batch for fleet workers (default off;
# auto-on when DENIZEN_FLEET_IDENTITY_ID or fleet/internal tokens are set)
# DENIZEN_MESH_JOBS=true
# DENIZEN_MESH_JOBS_INTERVAL_MS=300000

# NAS fleet agent — headless metrics reporter on Synology (not the full Electron app)
# DENIZEN_FLEET_AGENT_TOKEN=
# DENIZEN_FLEET_IDENTITY_ID=
# DENIZEN_FLEET_PROBE_URLS=http://<NAS_IP>:8000/rest/v1/
# DENIZEN_NAS_AGENT_HEALTH_URL=

# LM Studio inference pool (multi-machine) — required on NAS: point at GPU host(s)
# Leave LM_STUDIO_URL empty on NAS; set LM_STUDIO_REMOTE_URLS to your GPU machine(s).
# LM_STUDIO_URL=http://127.0.0.1:1234
LM_STUDIO_REMOTE_URLS=http://<PC_LAN_IP>:1234
LM_STUDIO_ROUTER=true
# Tier routing: fast for quick/light tasks, main for general work, heavy for reasoning/long-context
# On ~16GB GPUs: keep MAIN + FAST resident; HEAVY is JIT-only (auto-evicts with TTL).
# LM Studio (GPU host): Developer → Server → JIT ON, Auto-Evict ON. Do not autoload all models.
LM_STUDIO_MODEL=meta-llama-3.1-8b-instruct
LM_STUDIO_HEAVY_MODEL=qwen2.5-14b-instruct-1m
LM_STUDIO_FAST_MODEL=google/gemma-4-e2b
LM_STUDIO_PRELOAD_RESIDENT=1
LM_STUDIO_HEAVY_TTL_SEC=600
LM_STUDIO_RESIDENT_CTX=8192
# LM_STUDIO_PROBE_INTERVAL_MS=45000
# LM_STUDIO_SATURATED_QUEUE=4
# LM_STUDIO_PARALLEL=2

# AI behavior — production should use real LLM (not scripted CTO demo loop)
# Economy mode defaults ON in code; set false for live autonomous office.
DENIZEN_ECONOMY_MODE=false
# When economy mode is on, still run Abby/CTO via LM Studio if set true
DENIZEN_COFOUNDER_LLM=true
# Team visitors may run real tools (browser, coding-agent, research) when true
DENIZEN_REAL_WORK_MODE=true

# Public hosted demo (optional) — visitor path + Haiku; also use ?mode=demo in browser
# DENIZEN_PUBLIC_DEMO=false
# Trim loaded NPC brains to demo roster only (false = full office for CEO play)
# DENIZEN_PUBLIC_DEMO_TRIM_BRAINS=false
# DENIZEN_PUBLIC_DEMO_NPCS=abby,alex,lucy,bouncer
# Cloud Haiku for public demo (skips LM Studio for demo roster when set)
# DENIZEN_PUBLIC_DEMO_ANTHROPIC_KEY=
# DENIZEN_PUBLIC_DEMO_MODEL=claude-haiku-3-5-20241022

# WebSocket viewer cap (default 50; 30 when DENIZEN_PUBLIC_DEMO=true)
# DENIZEN_MAX_WS_CLIENTS=100

# Horizontal WS fan-out (Phase 5 — requires `npm install redis` when using redis)
# DENIZEN_WORLD_PUBSUB=memory
# DENIZEN_REDIS_URL=redis://127.0.0.1:6379
# DENIZEN_WORLD_PUBSUB_CHANNEL=denizen:world:broadcast
# DENIZEN_SERVER_ROLE=primary
# DENIZEN_PRIMARY_URL=http://127.0.0.1:8888
# DENIZEN_SPECTATE_WS_URL=wss://spectate.dolonia.cloud/agent-ws
# DENIZEN_SPECTATE_PUBLIC_URL=https://spectate.dolonia.cloud

# Inference mesh — Ollama, LM Studio, or llama.cpp (llama-server)
# DENIZEN_INFERENCE_BACKEND=auto
# OLLAMA_URL=http://127.0.0.1:11434
# LLAMACPP_URL=http://127.0.0.1:8081
# DENIZEN_INFERENCE_RPC_TIMEOUT_MS=120000
# DENIZEN_FEDERATION_PEERS=
# DENIZEN_FEDERATION_TOKEN=

# Platform CRM bridge — false on NAS-only Supabase (see docs/NAS_PLATFORM_BRIDGE.md)
# DENIZEN_PLATFORM_BRIDGE=false

# Self-healing / mesh ops (optional)
# DENIZEN_AUTO_HEAL=1
# DENIZEN_MESH_WATCHDOG_MS=90000
# DENIZEN_MESH_MAX_PENDING=8
# DENIZEN_MESH_KEEP_PRODUCER_BATCHES=2
# DENIZEN_MESH_PRODUCER_MAX_PENDING=10
# DENIZEN_PRODUCER_JOB_MAX_AGE_MS=7200000
# DENIZEN_SIM_TICK_MAX_AGE_MS=3600000
# LM_STUDIO_RESTART_CMD=
# DENIZEN_VERIFY_POLL_ATTEMPTS=12
# DENIZEN_VERIFY_POLL_MS=5000

# Desktop auto-update channel served at /desktop/updates/
# DENIZEN_UPDATE_CHANNEL=stable

# Cloud VM provisioning (optional — falls back to docker-sandbox)
# PROXMOX_API_URL=
# PROXMOX_TOKEN=
# PROXMOX_NODE=pve
# PROXMOX_TEMPLATE_ID=
# CLOUD_VM_WEBHOOK_URL=
# DENIZEN_MAX_CLOUD_VMS=4

# Server port (default 8080; NAS docker-compose uses 8888)
# PORT=8080

# Bouncer security (NAS Docker has no WSL — proxy Kali to dolonia)
# BOUNCER_PATROL=container
# NAS → dolonia investigation agent (Windows + Kali WSL on <PC_LAN_IP>)
# BOUNCER_INVESTIGATION_URL=http://<PC_LAN_IP>:8890
# BOUNCER_INVESTIGATION_TOKEN=
# Suppress false-positive threats from game server / mesh browser host
# DENIZEN_HOST_IP=<PC_LAN_IP>
# BOUNCER_INVESTIGATION_COOLDOWN_MS=900000

# Multi-node / NAS hosting (optional)
# DENIZEN_SERVER_ROLE=primary
# DENIZEN_SERVER_ID=nas-<NAS_IP>
