{
  "name": "denizen-desktop",
  "version": "0.1.6",
  "private": true,
  "description": "Denizen desktop shell (Electron)",
  "main": "main.js",
  "productName": "Denizen",
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/copy-denizen-src.js",
    "prebuild": "node scripts/copy-denizen-src.js",
    "prebuild:win": "node scripts/fetch-ollama.js && node scripts/fetch-llama-server.js && node scripts/copy-denizen-src.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dolonia.denizen",
    "productName": "Denizen",
    "directories": {
      "output": "dist-build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dolonia333",
        "repo": "DENIZEN"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": ["dmg", "zip"],
      "artifactName": "Denizen.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "Denizen.${ext}",
      "category": "Utility"
    },
    "nsis": {
      "artifactName": "Denizen-Setup.${ext}",
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    },
    "extraResources": [
      {
        "from": "resources/ollama",
        "to": "ollama",
        "filter": ["**/*"]
      },
      {
        "from": "resources/llama",
        "to": "llama",
        "filter": ["**/*"]
      }
    ],
    "protocols": [
      {
        "name": "Denizen",
        "schemes": ["denizen"]
      }
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!updates/**",
      "!dist-build*/**",
      "!dist-review*/**",
      "!dist-old-*/**"
    ]
  }
}
