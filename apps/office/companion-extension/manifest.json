{
  "manifest_version": 3,
  "name": "Denizen Companion",
  "version": "1.6.0",
  "description": "Sync any AI or app with your Denizen NPC assistant — no API keys required.",
  "permissions": ["storage", "contextMenus", "clipboardRead"],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8081/*",
    "http://127.0.0.1:8081/*",
    "https://denizen.dolonia.cloud/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Denizen Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*",
        "http://localhost:8081/*",
        "http://127.0.0.1:8081/*",
        "https://denizen.dolonia.cloud/*"
      ],
      "js": ["content-denizen.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "push-clipboard": {
      "suggested_key": { "default": "Ctrl+Shift+D", "mac": "Command+Shift+D" },
      "description": "Send clipboard to your Denizen NPC"
    }
  }
}
